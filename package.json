{
  "name": "powietrze-mcp",
  "version": "0.1.1",
  "description": "MCP server: air quality in Poland for AI agents – live GIOŚ measurements (PM2.5, PM10, NO2, O3) with the Polish air quality index, smog warnings, 3-day CAMS forecast and pollen. No API key.",
  "type": "module",
  "bin": {
    "powietrze-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"try{require('fs').chmodSync('dist/index.js',0o755)}catch(e){}\"",
    "test": "npm run build && node --test test/unit.test.mjs",
    "prepublishOnly": "npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jakosc-powietrza",
    "smog",
    "pm2.5",
    "pm10",
    "gios",
    "pylki",
    "air-quality",
    "pollen",
    "poland",
    "open-data",
    "claude",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContentWriterco/powietrze-mcp.git"
  },
  "homepage": "https://powietrze.compabase.com",
  "bugs": {
    "url": "https://github.com/ContentWriterco/powietrze-mcp/issues"
  },
  "mcpName": "io.github.ContentWriterco/powietrze-mcp"
}
